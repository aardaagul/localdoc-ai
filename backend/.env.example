# ---- Uygulama ----
APP_NAME=LocalDoc AI
API_PREFIX=/api
DEBUG=false

# ---- Depolama ----
# Bu satırları .env dosyasına yazmazsanız, koddaki mutlak varsayılanlar
# (backend/data/ altında localdoc.db ve uploads/) kullanılır.
# Yazarsanız yollar, sunucuyu çalıştırdığınız dizine göre çözülür;
# bu nedenle backend/ klasörünün içinden çalıştırın.
DATABASE_URL=sqlite:///./data/localdoc.db
UPLOAD_DIR=./data/uploads
DATA_DIR=./data
# Dosya boyutu sınırı (MB)
MAX_FILE_SIZE_MB=20
# İzin verilen uzantılar (virgülle ayrılmış)
ALLOWED_EXTENSIONS=pdf,txt

# ---- Ollama (yerel model sunucusu) ----
OLLAMA_BASE_URL=http://localhost:11434
# Sohbet (cevap üretme) modeli - donanımınıza uygun bir model seçin
OLLAMA_CHAT_MODEL=llama3.2
# Embedding (anlamsal arama) modeli
OLLAMA_EMBED_MODEL=nomic-embed-text
# Model yanıtı için zaman aşımı (saniye)
OLLAMA_TIMEOUT=120

# ---- RAG / Arama ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.1
MIN_SEMANTIC_SCORE=0.5
SEMANTIC_WEIGHT=0.5
MAX_QUESTION_LENGTH=2000

# ---- CORS ----
CORS_ORIGINS=*
