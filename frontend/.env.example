# Frontend, backend'e hangi adresten erişsin?
# Boş bırakılırsa (önerilen) geliştirme sırasında Vite proxy'si kullanılır.
# Üretim (build) için tam adresi verin, örn: http://localhost:8000
VITE_API_URL=

# Geliştirme sunucusunun /api isteklerini yönlendireceği backend adresi.
# Varsayılan: http://localhost:8000
VITE_PROXY_TARGET=http://localhost:8000
